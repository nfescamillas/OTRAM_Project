# Copy this file to .env.production and replace every placeholder.
# Never commit .env.production. Use a deployment secret manager where available.

# Pin the exact image produced by CI. Do not use :main for production.
OTARM_IMAGE=ghcr.io/nfescamillas/otram_project:sha-<full-commit-sha>

# Generate independent production values; do not reuse development credentials.
# Use a long hexadecimal or URL-encoded database password because it is embedded in a URL.
OTARM_PROD_POSTGRES_PASSWORD=<strong-random-hexadecimal-database-password>
OTARM_PROD_DEMO_PASSWORD=<strong-random-demo-password>
OTARM_PROD_TOKEN_SECRET=<at-least-48-random-bytes>

# The production copy defaults to port 8080 so dev can remain on port 8000.
OTARM_PROD_PORT=8080
OTARM_PROD_TOKEN_TTL_SECONDS=3600

# Leave empty for same-origin deployments. For a separate browser origin, list it here.
OTARM_PROD_CORS_ORIGINS=


# Prometheus exposes active alerts through this API. In Docker, use
# http://prometheus:9090/api/v1/alerts from a container on the observability network.
ON_CALL_ALERTS_URL=http://localhost:9090/api/v1/alerts

# Optional bearer token for a protected alert endpoint. Do not commit the value.
ON_CALL_ALERTS_TOKEN=

# Repository the agent may inspect. Relative paths resolve from this directory.
ON_CALL_REPOSITORY=..

# Polling and execution bounds.
ON_CALL_POLL_SECONDS=60
ON_CALL_REQUEST_TIMEOUT_SECONDS=10
ON_CALL_AGENT_TIMEOUT_SECONDS=900
ON_CALL_MAX_CONCURRENT_AGENTS=2

# Runtime state and result files. These paths are ignored by Git.
ON_CALL_STATE_FILE=var/state.json
ON_CALL_RUNS_DIRECTORY=var/runs

# Default command is deliberately read-only and ephemeral. JSON array syntax avoids
# shell parsing. The final '-' makes Codex read the prompt from standard input.
ON_CALL_AGENT_COMMAND=["codex","exec","--ephemeral","--ignore-user-config","--sandbox","read-only","--color","never","-"]
